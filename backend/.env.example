# ================================================================================
# Backend
# ================================================================================
# Postgres DB
POSTGRES_DB            = 
POSTGRES_USER          = 
POSTGRES_PASSWORD      = 

# Vector DB
VECTOR_DB_NAME         = 
VECTOR_DB_USER         = 
VECTOR_DB_PASSWORD     = 

# Other Django config
DJANGO_SETTINGS_MODULE  = "backend.settings"
DJANGO_DEBUG            = true
DJANGO_SECRET_KEY       =
TZ                      = "UTC"

# Google Speech
GOOGLE_APPLICATION_CREDENTIALS =  # Need to get an API key and put it in /backend
GOOGLE_API_KEY                 = 
PEXELS_KEY                     = 0

# Image API
PEXELS_KEY = 

# For development (localhost)
DEV_APP_ROUTE = "http://localhost:8000" #  "" Nothing for deployment mode

# --------------------------------------------------------------------------------
# Audio Storage
# --------------------------------------------------------------------------------
# Session audio storage (use "local" for local Docker, "gcs" on the deployed VM)
SESSION_AUDIO_STORAGE              = local
SESSION_AUDIO_LOCAL_ROOT           = /app/media
SESSION_AUDIO_TEMP_ROOT            = /tmp/cognibot_recordings
SESSION_AUDIO_GCS_BUCKET           =
SESSION_AUDIO_OBJECT_PREFIX        = recordings
SESSION_AUDIO_PLAYBACK_URL_TTL_SEC = 3600

# --------------------------------------------------------------------------------
# LLM Settings
# --------------------------------------------------------------------------------
# Local vs. cloud environment; local uses dummy_LLM, cloud uses GPU instance
APP_ENVIRONMENT  = "local"

# Access to the external GPU VM instance
LLM_BASE_URL      =
LLM_GATEWAY_TOKEN =

# Standard (non-activity) chat response mode: "single_stage" | "active_listening"
LIVE_CHAT_RESPONSE_MODE = "single_stage"

# --------------------------------------------------------------------------------
# IU API
# --------------------------------------------------------------------------------
# Specify which model to use via `LLM_NAME`
IU_URL   =
IU_KEY   =
LLM_NAME = 

# --------------------------------------------------------------------------------
# Admin & Demo user login information
# --------------------------------------------------------------------------------
# Primary admin user
ADMIN_USERNAME_0 = 
ADMIN_PASSWORD_0 = 

# Protected demo data user
DEMO_USERNAME_0 = 
DEMO_PASSWORD_0 = 
