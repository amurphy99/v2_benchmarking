# ================================================================================
# Backend
# ================================================================================
# Postgres DB
POSTGRES_DB            = 
POSTGRES_USER          = 
POSTGRES_PASSWORD      = 
POSTGRES_HOST          = db
POSTGRES_PORT          = 5432

# Vector DB
VECTOR_DB_NAME         = 
VECTOR_DB_USER         = 
VECTOR_DB_PASSWORD     = 
VECTOR_DB_HOST         = db_vector
VECTOR_DB_PORT         = 5432

# Other Django config
DJANGO_SETTINGS_MODULE  = "backend.settings"
DJANGO_DEBUG            = true
DJANGO_SECRET_KEY       =
TZ                      = "UTC"

# --------------------------------------------------------------------------------
# Admin & Demo user login information
# --------------------------------------------------------------------------------
# Primary admin user (highest level of permissions)
ADMIN_USERNAME_0 = 
ADMIN_PASSWORD_0 = 

# Secondary admin user (no permissions for the Django admin page)
ADMIN_USERNAME_1 =
ADMIN_PASSWORD_1 =

# Protected demo data user (real demo data)
DEMO_USERNAME_0 = 
DEMO_PASSWORD_0 = 

# Buddy robot user (who the Buddy robot logs in as)
BUDDY_USERNAME =
BUDDY_PASSWORD =

# --------------------------------------------------------------------------------
# Seed Data
# --------------------------------------------------------------------------------
SEED_UI_SAMPLE_DATA       = false  # Create missing random UI chats, reminders, activities, and RAG fixtures
SEED_ANALYZED_CHAT_DATA   = false  # Create missing fixed text-only chats with saved post-chat analysis
SEED_TRANSCRIPT_CHAT_DATA = false  # Create missing imported transcript, audio, and biomarker fixtures

# --------------------------------------------------------------------------------
# Google Cloud Credentials
# --------------------------------------------------------------------------------
# Used for speech (STT & TTS) as well as cloud storage (GCS) bucket access
GOOGLE_APPLICATION_CREDENTIALS =  # Need to get an API key and put it in /backend
GOOGLE_API_KEY                 = 
GOOGLE_GENAI_USE_VERTEXAI      = 0

# --------------------------------------------------------------------------------
# Audio Storage
# --------------------------------------------------------------------------------
# Session audio storage (use "local" for local Docker, "gcs" on the deployed VM)
SESSION_AUDIO_STORAGE    = local       # local | gcs
SESSION_AUDIO_LOCAL_ROOT = /app/media  # Where .wav files are saved when in "local" mode

# Where recordings are stored locally before a chat ends and they get deleted or uploaded
SESSION_AUDIO_TEMP_ROOT  = /tmp/cognibot_recordings

# Configuration for Google Cloud Storage mode
# For the prefix, the deployment code will prepend the version (e.g., it becomes: "sandbox1/recordings")
SESSION_AUDIO_GCS_BUCKET           = session_audio-v1
SESSION_AUDIO_OBJECT_PREFIX        = recordings
SESSION_AUDIO_PLAYBACK_URL_TTL_SEC = 3600

# --------------------------------------------------------------------------------
# LLM Settings
# --------------------------------------------------------------------------------
# Set to false only when using the dummy LLM for local testing
USE_LLM = true

# Access to the external GPU VM instance
LLM_BASE_URL      =
LLM_GATEWAY_TOKEN =

# Standard (non-activity) chat response mode: "single_stage" | "active_listening"
LIVE_CHAT_RESPONSE_MODE = "single_stage"

# Specify which model to use: "gemma-4-31B-it" | "Qwen3-Coder-Next"
LLM_NAME = "gemma-4-31B-it"

# --------------------------------------------------------------------------------
# IU API
# --------------------------------------------------------------------------------
IU_URL =
IU_KEY =

# --------------------------------------------------------------------------------
# Misc.
# --------------------------------------------------------------------------------
# Image API
PEXELS_KEY = 
